        <dict><key>patterns</key><array><dict>
            <key>name</key><string>meta.loop.binding-list.vulci</string>
            <key>begin</key><string>(\.)(each|times)(\s*)(\()(?=(?:[^\(\)]|\([^\(\)]*\))*\)\s*\{)</string><key>end</key><string>\)</string>
            <key>beginCaptures</key><dict><key>1</key><dict><key>name</key><string>punctuation.accessor.vulci</string></dict><key>2</key><dict><key>name</key><string>keyword.control.loop.vulci</string></dict><key>4</key><dict><key>name</key><string>punctuation.section.parens.begin.vulci</string></dict></dict>
