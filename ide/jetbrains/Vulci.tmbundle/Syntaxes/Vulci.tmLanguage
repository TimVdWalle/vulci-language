        <key>invalid</key>
        <dict><key>patterns</key><array>
            <dict><key>name</key><string>invalid.illegal.semicolon.vulci</string><key>match</key><string>;</string></dict>
            <dict><key>name</key><string>invalid.illegal.operator.vulci</string><key>match</key><string>!(?!=)</string></dict>
