        <key>function-declaration</key>
        <dict>
            <key>name</key><string>meta.function.definition.vulci</string>
            <key>match</key><string>\b(fn)(\s+)([A-Za-z_][A-Za-z0-9_]*)</string>
            <key>captures</key><dict><key>1</key><dict><key>name</key><string>keyword.declaration.function.vulci</string></dict><key>3</key><dict><key>name</key><string>meta.tag.function.declaration.vulci</string></dict></dict>
