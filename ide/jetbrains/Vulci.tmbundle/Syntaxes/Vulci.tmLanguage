        <key>operators</key>
        <dict><key>patterns</key><array>
            <dict><key>name</key><string>keyword.operator.assignment.vulci</string><key>match</key><string>=(?!=)</string></dict>
            <dict><key>name</key><string>keyword.operator.comparison.vulci</string><key>match</key><string>==|!=|&lt;=|&gt;=|&lt;|&gt;</string></dict>
            <dict><key>name</key><string>keyword.operator.arithmetic.vulci</string><key>match</key><string>[+*/%-]</string></dict>
            <dict><key>name</key><string>keyword.operator.concatenation.vulci</string><key>match</key><string>~</string></dict>
            <dict><key>name</key><string>keyword.operator.type.union.vulci</string><key>match</key><string>\|</string></dict>
        </array></dict>
        <key>punctuation</key>
        <dict><key>patterns</key><array>
            <dict><key>name</key><string>punctuation.separator.vulci</string><key>match</key><string>[,:]</string></dict>
            <dict><key>name</key><string>punctuation.accessor.vulci</string><key>match</key><string>\.</string></dict>
            <dict><key>name</key><string>punctuation.section.parens.vulci</string><key>match</key><string>[()]</string></dict>
            <dict><key>name</key><string>punctuation.section.brackets.vulci</string><key>match</key><string>[\[\]]</string></dict>
