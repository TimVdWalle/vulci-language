                <dict><key>include</key><string>#operators</string></dict>
                <dict><key>include</key><string>#punctuation</string></dict>
            </array>
        </dict></array></dict>
        <key>typed-bindings</key>
        <dict><key>patterns</key><array>
            <dict>
                <key>match</key><string>(\(|,)(\s*)((?:list|set|map|collection)(?:\s*&lt;[^&gt;\n]+&gt;)?(?:\s*\|\s*(?:[A-Za-z_][A-Za-z0-9_]*(?:\s*(?:&lt;[^&gt;\n]+&gt;|\([^\)\n]+\)))?))*)(\s+)([a-z_][A-Za-z0-9_]*)(?=\s*(?:=|,|\)))</string>
                <key>captures</key><dict><key>1</key><dict><key>name</key><string>punctuation.section.parameters.vulci</string></dict><key>3</key><dict><key>name</key><string>entity.name.function.collection.vulci</string></dict><key>5</key><dict><key>name</key><string>entity.name.function.parameter.vulci</string></dict></dict>
            </dict>
            <dict>
                <key>match</key><string>(\(|,)(\s*)((?:[A-Za-z_][A-Za-z0-9_]*(?:\s*(?:&lt;[^&gt;\n]+&gt;|\([^\)\n]+\)))?)(?:\s*\|\s*(?:[A-Za-z_][A-Za-z0-9_]*(?:\s*(?:&lt;[^&gt;\n]+&gt;|\([^\)\n]+\)))?))*)(\s+)([a-z_][A-Za-z0-9_]*)(?=\s*(?:=|,|\)))</string>
                <key>captures</key><dict><key>1</key><dict><key>name</key><string>punctuation.section.parameters.vulci</string></dict><key>3</key><dict><key>name</key><string>keyword.control.type.vulci</string></dict><key>5</key><dict><key>name</key><string>entity.name.function.parameter.vulci</string></dict></dict>
            </dict>
        </array></dict>
        <key>type-groups</key>
        <dict><key>patterns</key><array>
            <dict>
                <key>begin</key><string>\b(tuple)(\s*)(\()</string><key>end</key><string>\)</string>
                <key>beginCaptures</key><dict><key>1</key><dict><key>name</key><string>keyword.control.type.vulci</string></dict><key>3</key><dict><key>name</key><string>punctuation.definition.type.begin.vulci</string></dict></dict>
                <key>endCaptures</key><dict><key>0</key><dict><key>name</key><string>punctuation.definition.type.end.vulci</string></dict></dict>
                <key>patterns</key><array><dict><key>include</key><string>#types</string></dict><dict><key>include</key><string>#operators</string></dict><dict><key>include</key><string>#punctuation</string></dict></array>
            </dict>
            <dict>
                <key>begin</key><string>\b(list|set|map)(\s*)(&lt;)</string><key>end</key><string>&gt;</string>
                <key>beginCaptures</key><dict><key>1</key><dict><key>name</key><string>entity.name.function.collection.vulci</string></dict><key>3</key><dict><key>name</key><string>punctuation.definition.type.begin.vulci</string></dict></dict>
                <key>endCaptures</key><dict><key>0</key><dict><key>name</key><string>punctuation.definition.type.end.vulci</string></dict></dict>
                <key>patterns</key><array><dict><key>include</key><string>#types</string></dict><dict><key>include</key><string>#operators</string></dict><dict><key>include</key><string>#punctuation</string></dict></array>
            </dict>
        </array></dict>

        <key>keywords</key>
        <dict><key>patterns</key><array>
            <dict><key>name</key><string>keyword.control.import.vulci</string><key>match</key><string>\bimport\b</string></dict>
            <dict><key>name</key><string>keyword.control.conditional.vulci</string><key>match</key><string>\b(?:if|else)\b</string></dict>
            <dict><key>name</key><string>keyword.control.loop.vulci</string><key>match</key><string>\b(?:while|break)\b</string></dict>
            <dict><key>name</key><string>keyword.control.return.vulci</string><key>match</key><string>\breturn\b</string></dict>
            <dict><key>name</key><string>keyword.declaration.return-type.vulci</string><key>match</key><string>\breturns\b</string></dict>
            <dict><key>name</key><string>keyword.operator.logical.vulci</string><key>match</key><string>\b(?:and|or|not)\b</string></dict>
            <dict><key>name</key><string>keyword.operator.type-test.vulci</string><key>match</key><string>\bis\b</string></dict>
            <dict><key>name</key><string>keyword.declaration.function.vulci</string><key>match</key><string>\bfn\b</string></dict>
            <dict><key>name</key><string>keyword.declaration.type.vulci</string><key>match</key><string>\b(?:struct|enum)\b</string></dict>
        </array></dict>
        <key>types</key>
        <dict><key>patterns</key><array>
            <dict><key>include</key><string>#type-groups</string></dict>
            <dict><key>name</key><string>entity.name.function.collection.vulci</string><key>match</key><string>\b(?:list|set|map)(?=\s*\[)</string></dict>
            <dict><key>name</key><string>meta.tag.function.builtin.vulci</string><key>match</key><string>\bobject(?=\s*\()</string></dict>
            <dict><key>name</key><string>keyword.control.type.vulci</string><key>match</key><string>\b(?:int|bool|str|any|tuple)\b</string></dict>
            <dict><key>name</key><string>entity.name.function.collection.vulci</string><key>match</key><string>\b(?:list|set|map|collection)\b</string></dict>
            <dict><key>name</key><string>entity.name.function.type.vulci</string><key>match</key><string>\b[A-Z][A-Za-z0-9_]*\b</string></dict>
        </array></dict>
        <key>constants</key>
        <dict><key>patterns</key><array>
            <dict><key>name</key><string>constant.language.vulci</string><key>match</key><string>\b(?:true|false|null)\b</string></dict>
            <dict><key>name</key><string>constant.numeric.integer.vulci</string><key>match</key><string>\b[0-9]+(?:_[0-9]+)*\b</string></dict>
            <dict><key>match</key><string>(\.)([A-Z][A-Za-z0-9_]*)\b</string><key>captures</key><dict><key>1</key><dict><key>name</key><string>punctuation.accessor.vulci</string></dict><key>2</key><dict><key>name</key><string>constant.other.enum.vulci</string></dict></dict></dict>
        </array></dict>
        <key>variables</key>
        <dict><key>patterns</key><array>
            <dict><key>name</key><string>keyword.control.self.vulci</string><key>match</key><string>\bself\b</string></dict>
            <dict><key>match</key><string>(\$)([A-Za-z_][A-Za-z0-9_]*)</string><key>captures</key><dict><key>1</key><dict><key>name</key><string>constant.language.global.vulci</string></dict><key>2</key><dict><key>name</key><string>constant.language.global.vulci</string></dict></dict></dict>
        </array></dict>
        <key>calls-and-members</key>
        <dict><key>patterns</key><array>
            <dict><key>match</key><string>(\.)([A-Za-z_][A-Za-z0-9_]*)(?=\s*\()</string><key>captures</key><dict><key>1</key><dict><key>name</key><string>punctuation.accessor.vulci</string></dict><key>2</key><dict><key>name</key><string>meta.tag.function.method.vulci</string></dict></dict></dict>
            <dict><key>match</key><string>(\.)([A-Za-z_][A-Za-z0-9_]*)</string><key>captures</key><dict><key>1</key><dict><key>name</key><string>punctuation.accessor.vulci</string></dict><key>2</key><dict><key>name</key><string>constant.other.property.vulci</string></dict></dict></dict>
            <dict><key>name</key><string>constant.other.named-argument.vulci</string><key>match</key><string>\b[A-Za-z_][A-Za-z0-9_]*\b(?=\s*:)</string></dict>
            <dict><key>name</key><string>meta.tag.function.call.vulci</string><key>match</key><string>\b[a-z_][A-Za-z0-9_]*\b(?=\s*\()</string></dict>
            <dict><key>name</key><string>entity.name.function.local.vulci</string><key>match</key><string>\b[a-z_][A-Za-z0-9_]*\b</string></dict>
