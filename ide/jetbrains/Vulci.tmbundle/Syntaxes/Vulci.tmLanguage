            </dict>
            <dict>
                <key>name</key><string>meta.field.declaration.vulci</string>
                <key>match</key><string>^\s*([A-Za-z_][A-Za-z0-9_]*(?:\s*(?:&lt;[^&gt;\n]+&gt;|\([^\)\n]+\)))?(?:\s*\|\s*[A-Za-z_][A-Za-z0-9_]*(?:\s*(?:&lt;[^&gt;\n]+&gt;|\([^\)\n]+\)))?)*)(\s+)([a-z_][A-Za-z0-9_]*)(?=\s*(?:=|$))</string>
                <key>captures</key><dict><key>1</key><dict><key>name</key><string>keyword.control.type.vulci</string></dict><key>3</key><dict><key>name</key><string>constant.other.member.vulci</string></dict></dict>
            </dict>
        </array></dict>
        <key>enum-declaration</key>
        <dict>
            <key>name</key><string>meta.type.enum.vulci</string>
            <key>begin</key><string>\b(enum)(\s+)([A-Za-z_][A-Za-z0-9_]*)(\s*)(\{)</string><key>end</key><string>\}</string>
            <key>beginCaptures</key><dict><key>1</key><dict><key>name</key><string>keyword.declaration.enum.vulci</string></dict><key>3</key><dict><key>name</key><string>entity.name.function.type-declaration.vulci</string></dict><key>5</key><dict><key>name</key><string>punctuation.section.block.begin.vulci</string></dict></dict>
            <key>endCaptures</key><dict><key>0</key><dict><key>name</key><string>punctuation.section.block.end.vulci</string></dict></dict>
            <key>patterns</key><array><dict><key>include</key><string>#comments</string></dict><dict><key>name</key><string>constant.other.enum.vulci</string><key>match</key><string>\b[A-Za-z_][A-Za-z0-9_]*\b</string></dict></array>
